#!/usr/bin/env bash
# Valida Conventional Commits en el repositorio del informe.
# Instalar con: bash scripts/setup-hooks.sh
# --- Sin coautoria de IA: estos pies se eliminan antes de validar el mensaje ---
__limpio="$1.sin-ia"
grep -viE '^[[:space:]]*(co-authored-by:.*(claude|anthropic)|claude-session:|.*generated with \[claude code\])' "$1" > "$__limpio" || true
awk '{l[NR]=$0} END{u=NR; while(u>0 && l[u] ~ /^[[:space:]]*$/) u--; for(i=1;i<=u;i++) print l[i]}' "$__limpio" > "$1"
rm -f "$__limpio"
# --- fin del bloque ---
mensaje=$(head -n1 "$1")

if [[ "$mensaje" =~ ^(Merge|Revert) ]]; then
  exit 0
fi

patron='^(docs|fix|chore|style|refactor|feat|revert)(\([a-z0-9_-]+\))?!?: .{1,100}$'

if [[ ! "$mensaje" =~ $patron ]]; then
  cat <<'MSG' >&2

  ✖ El mensaje de commit no cumple Conventional Commits.

  Formato:  tipo(alcance): descripcion en minuscula, modo imperativo

  Tipos:    docs  fix  chore  style  refactor  feat  revert
  Alcance:  cap01 ... cap08, indice, build, assets

  Ejemplos:
    docs(cap01): redactar antecedentes y problematica con 5w2h
    docs(cap08): documentar el calculo de tamano de muestra
    fix(indice): corregir enlaces rotos del capitulo 6

MSG
  echo "  Tu mensaje fue: $mensaje" >&2
  echo "" >&2
  exit 1
fi
